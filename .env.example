# ==============================================================================
# Zoheb LLM Agent Toolkit - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your credentials.
# WARNING: Keep this toolkit strictly within virtualized/isolated lab environments.

# Primary LLM Provider (options: google, openai, anthropic, ollama)
DEFAULT_LLM_PROVIDER=google

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama / Local Models (OpenAI compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Lab Server Bind Settings
LAB_HTTP_HOST=0.0.0.0
LAB_HTTP_PORT=8080
LAB_FTP_HOST=0.0.0.0
LAB_FTP_PORT=2121
LAB_FTP_USER=labuser
LAB_FTP_PASS=labpass123
